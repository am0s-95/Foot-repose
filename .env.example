# Copy the values you need into the right place — never commit real secrets.
#
#   API app      -> apps/api/.env.local        (DATABASE_URL, AUTH_SECRET)
#   Frontends    -> shell env or apps/<app>/.env.local (API_URL, optional locally)
#   DB scripts   -> .env at the repo root      (DATABASE_URL)
#   Tests        -> TEST_DATABASE_URL in shell or repo-root .env

# PostgreSQL connection (Supabase: use the "Connection string" of your project)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foot_repose_dev

# Separate database used by the API integration tests (its schema is dropped
# and recreated on every test run — never point this at real data)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/foot_repose_test

# Secret used to sign employee session tokens. Must be at least 32 chars —
# generate with `openssl rand -hex 32`. The API refuses to run with this
# placeholder value.
AUTH_SECRET=change-me

# Where the frontends reach the shared API (they proxy /api/* to this origin)
API_URL=http://localhost:3000

# Browser origins allowed to send state-changing requests (CSRF guard).
# Defaults to the three local frontends when unset.
#ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# The seed TRUNCATEs every table. It only runs when this is set explicitly
# (plus: never in production, and only against *_dev/_development/_local DBs).
#SEED_CONFIRM=wipe
