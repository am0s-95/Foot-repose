# Copy the values you need into the right place — never commit real secrets.
#
#   API app      -> apps/api/.env.local        (DATABASE_URL, AUTH_SECRET)
#   Frontends    -> shell env or apps/<app>/.env.local (API_URL — REQUIRED for
#                   the branch app, at RUN time, not at build time)
#   DB scripts   -> .env at the repo root      (DATABASE_URL)
#   Tests        -> TEST_DATABASE_URL in shell or repo-root .env

# PostgreSQL connection (Supabase: use the "Connection string" of your project)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/foot_repose_dev

# Optional: the Asia/Muscat operational date the development seed builds its
# three days (yesterday / today / tomorrow) around. Unset means today, which is
# what a developer wants. Tests and CI always set it explicitly, because the
# seeded volume is a function of the weekday — the weekly day off seeds no
# bookings at all — and a test that depends on the calendar passes or fails by
# calendar. Format: YYYY-MM-DD; a malformed or non-existent date is rejected.
#SEED_REFERENCE_DATE=2026-08-05

# Database used ONLY by the one-time 62-date seed audit
# (packages/db/src/seed-audit.ts). It wipes and reseeds once per date, so it
# must not be the application or integration-test database — the script refuses
# to start if it is, before writing anything. Sharing one corrupted both and
# surfaced as a fake determinism failure.
#SEED_AUDIT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/foot_repose_audit_local

# Separate database used by the API integration tests (its schema is dropped
# and recreated on every test run — never point this at real data; the reset
# helpers double-check the LIVE connection and refuse any database whose
# actual name does not end exactly in _test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/foot_repose_test

# Secret used to sign employee session tokens. Must be at least 32 chars —
# generate with `openssl rand -hex 32`. The API refuses to run with this
# placeholder value.
AUTH_SECRET=change-me

# Where the frontends reach the shared API. The browser never sees this value —
# it always calls /api/* on the frontend's OWN origin, which is what keeps the
# session cookie HttpOnly and same-site with no CORS. The frontend forwards.
#
# Read at RUN time, per request. The branch app's artifact carries no
# destination at all, so one build can be promoted between environments by
# changing this variable and restarting. It used to be read during `next build`
# and frozen into the artifact, which meant the opposite: the only way to move
# an artifact was to rebuild it, so what shipped was never what was tested.
#
# The branch app REQUIRES it — a missing or malformed value makes /api/* answer
# 503 rather than silently proxying to a guessed localhost. Must be a bare
# origin: http: or https:, no credentials, no path, no query, no fragment.
API_URL=http://localhost:3000

# Browser origins allowed to send state-changing requests (CSRF guard).
# Defaults to the three local frontends when unset.
#ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# How many proxy hops in front of the API are under YOUR control. Unset or 0
# (the default) means no client address is authoritative: X-Forwarded-For is
# ignored, and no request address is stored in sessions or audit_logs.
#
# Only set this once the deployment actually enforces it:
#   * the origin refuses any connection that did not come through those N hops
#     (private networking, an authenticated tunnel, or an IP allowlist);
#   * each of those hops appends the address it really observed.
# Without the first point an attacker reaches the origin directly and chooses
# the value this would trust. Parsing in the application cannot prove it.
#TRUSTED_PROXY_HOPS=1

# The seed TRUNCATEs every table. It only runs when this is set explicitly
# (plus: never in production, and only against databases named
# *_dev/_development/_local/_test).
#SEED_CONFIRM=wipe
